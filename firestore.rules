rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user owns the document (by verifying auth.uid matches userId in path)
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Clipboards Collection
    match /clipboards/{clipboardId} {
      // Check ownerId field on the document
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Explicit User Sub-collections
    match /users/{userId}/folders/{folderId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/favorites/{favId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/archived/{archId} {
      allow read, write: if isOwner(userId);
    }

    // Catch-all for other subcollections (fallback)
    match /users/{userId}/{restOfPath=**} {
      allow read, write: if isOwner(userId);
    }
  }
}
